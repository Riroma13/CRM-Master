# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_master?schema=public"

# API
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Better-Auth
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:4000
OAUTH_SOCIAL_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
OAUTH_RETURN_ORIGINS=http://localhost:3000,http://localhost:3001

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# App
NODE_ENV=development
