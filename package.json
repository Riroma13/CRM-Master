{
  "name": "crm-master",
  "private": true,
  "version": "0.0.1",
  "description": "SaaS multi-tenant de gestión empresarial",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "sdd:validate": "node scripts/validate-sdd-direct.mjs",
    "sdd:validate:design": "node scripts/validate-enterprise-design.mjs",
    "test:sdd-runtime": "node --test scripts/sdd-runtime.test.mjs scripts/sdd-runtime.integration.test.mjs scripts/sdd-runtime.e2e.test.mjs scripts/sdd-resume.test.mjs",
    "test:sdd-resume": "node --test scripts/sdd-resume.test.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
